
// T239 channel GPFIFO
engine Gpfifo 0xC36F;

0x004 SemaphoreOffset iova;
0x006 SemaphorePayload;
0x007 Semaphore bits (
	0..4 Operation enum (
		1  Acquire;
		2  Release;
		4  AcqGeq;    // acquire greater-or-equal
		8  AcqAnd;    // acquire with bitwise and?
		16 Reduction;
	);
	12 AcquireSwitch bool;
	20 ReleaseWfiDisable bool;
	24 ReleaseSize enum (
		0 _16;
		1 _4;
	);
	27..30 Reduction enum (
		0 Min;
		1 Max;
		2 Xor;
		3 And;
		4 Or;
		5 Add;
		6 Inc;
		7 Dec;
	);
	31 Format enum (
		0 Signed;
		1 Unsigned;
	);
);

0x00A MemOpA;
0x00B MemOpB;
0x00C MemOpC bits (
	0..2 MembarType enum (
		0 SysMembar;
		1 Membar;
	);
);
0x00D MemOpD bits (
	27..31 Operation enum (
		5  Membar;
		9  MmuTlbInvalidate;
		10 MmuTlbInvalidateTargeted;
		13 L2PeerMemInvalidate;
		14 L2SysmemInvalidate;
		15 L2CleanComptags;
		16 L2FlushDirty;
		21 L2WaitForSysPendingReads;
	);
);

0x014 SetReference;

0x01C SyncpointPayload;
0x01D Syncpoint bits (
	0 Operation enum (
		0 Wait;
		1 Incr;
	);
	4 WaitSwitch bool;
	8..15 SyncptIndex;
);

0x01E Wfi bits (
	0 Scope enum (
		0 Current;
		1 All;
	);
);
